{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waybarrios.github.io/vllm-mlx/schemas/model-profile-import-result-v1.schema.json",
  "title": "vllm-mlx ModelProfile legacy import result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "complete", "sources", "profile", "issues"],
  "properties": {
    "schema_version": { "const": 1 },
    "complete": { "type": "boolean" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "location", "sha256"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["acquisition", "conversion", "registration", "registry", "cli_server", "qualification"]
          },
          "location": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
        }
      }
    },
    "profile": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/profile_fragment" }
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "pointer", "sources", "detail"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "severity": { "type": "string", "enum": ["error", "warning"] },
          "pointer": { "type": "string", "pattern": "^/" },
          "sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "detail": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "complete": { "const": true } } },
      "then": {
        "properties": {
          "profile": { "$ref": "model-profile-v1.schema.json" },
          "issues": {
            "not": {
              "contains": {
                "type": "object",
                "required": ["severity"],
                "properties": { "severity": { "const": "error" } }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "issues": { "minItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "profile_fragment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": 1 },
        "profile_id": { "type": "string", "minLength": 1 },
        "profile_revision": { "type": "integer", "minimum": 1 },
        "subject_digest": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "description": { "type": "string" },
        "identity": { "type": "object" },
        "artifact": { "type": "object" },
        "capabilities": { "type": "object" },
        "serving": { "type": "object" },
        "hardware_fit": { "type": "array" },
        "qualification": { "type": "object" },
        "provenance": { "type": "object" },
        "extensions": { "type": "object" }
      }
    }
  }
}
